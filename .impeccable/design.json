  "narrative": {
    "northStar": "The Night Feed",
    "overview": "Panelport is a quiet night-blue room where one panel at a time owns the stage, the way one item fills a vertical video feed. The selected panel's own picture sits under a dark lower scrim and its name is set huge in thin condensed capitals across the bottom edge; everything else (the list of panels, the ringed actions, the title bar) stays white, thin and out of the way. The category's grey grid of identical status cards is what this world refuses.",
    "keyCharacteristics": [
      "A radial night-blue ground with a darker floor; white is the only interface colour.",
      "Panel names in Antonio caps: huge on the stage and down page, 30 px in lists.",
      "State shown as a ringed dot plus the state word in the state's colour, never colour alone.",
      "Hairline white pills and ringed glyph buttons; the primary action is the filled white ring.",
      "Every window wears the same 44 px title bar with thin white caption glyphs."
    ],
    "rules": [
      { "name": "The State-Only Colour Rule", "body": "Green, amber and red appear only where they mean a panel's state, the fix for it, or an on switch. No decorative colour anywhere else.", "section": "colors" },
      { "name": "The Words-With-Dots Rule", "body": "A state dot is always followed by the state in words.", "section": "colors" },
      { "name": "The English Caps Rule", "body": "Uppercased panel names render with lang=\"en\" unless they contain Turkish letters, so names never pick up a dotted capital İ.", "section": "typography" },
      { "name": "The One Lifted Object Rule", "body": "Only the stage casts a shadow; lists, cards and rows stay flat.", "section": "elevation" }
    ],
    "dos": [
      "Do keep white the only interface colour and reserve green, amber and red for state.",
      "Do set panel names in Antonio caps with lang=\"en\" for non-Turkish names.",
      "Do pair every state dot with the state word, at 14 px or larger.",
      "Do keep the stage the only shadowed object.",
      "Do load fonts from the app's own files; nothing from the network."
    ],
    "donts": [
      "Don't add labels above headings; status and scan lines go below their heading.",
      "Don't introduce a second accent colour or coloured side borders.",
      "Don't show a live panel inside the launcher; only its stored preview.",
      "Don't use looping horizontal loaders; a breathing dot marks ongoing checks."
    ]
  }
}
